# Load explicitly in your shell; the service does not auto-load a .env file.
AI_SERVICE_TOKEN=
AI_DATABASE_URL=postgresql://finguard:REPLACE@localhost:55432/finguard
AI_CLASSIFIER_MODE=local
AI_CLASSIFIER_PATH=.artifacts/classifier.json
AI_ALLOW_DEMO_MODEL=false
AI_GEMINI_API_KEY=
# Set a currently available Gemini generateContent model supporting structured output.
AI_GENERATION_MODEL=
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_REQUEST_TIMEOUT_SECONDS=4
AI_RETRIEVAL_TOP_K=5
# Experimental cosine cutoff, not a probability or a validated domain threshold.
AI_RETRIEVAL_MIN_SCORE=0.6
