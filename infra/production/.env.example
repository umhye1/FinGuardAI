# Server-only file. Copy to .env, chmod 600, and fill locally.
# No protocol/path: use a DNS name pointing to this server.
SITE_DOMAIN=
POSTGRES_PASSWORD=
JWT_SECRET=
AI_SERVICE_TOKEN=
# Absolute directory containing reviewed, non-demo classifier.json (readable by UID 10001).
MODEL_DIR=/opt/finguard/models
AI_PROVIDER=openai
AI_OPENAI_API_KEY=
AI_GEMINI_API_KEY=
AI_GENERATION_MODEL=gpt-4.1-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
