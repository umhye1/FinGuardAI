{
  "openapi": "3.0.3",
  "info": {
    "title": "FinGuardAI internal AI contract",
    "version": "1.0.0",
    "description": "Backend client contract. AI service implementation is separate. Use TLS/private network and verify service credentials."
  },
  "security": [
    {
      "ServiceToken": []
    }
  ],
  "components": {
    "securitySchemes": {
      "ServiceToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Service-Token"
      }
    }
  },
  "paths": {
    "/internal/v1/classifications": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  }
                },
                "required": [
                  "text"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Unwrapped AI result (not CommonResponse)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "COMPLETED"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "enum": [
                        "PHISHING",
                        "NORMAL"
                      ],
                      "nullable": true
                    },
                    "decision": {
                      "type": "string",
                      "enum": [
                        "FLAG",
                        "PASS",
                        "ABSTAIN"
                      ]
                    },
                    "modelVersion": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "errorCode": {
                      "type": "string",
                      "nullable": true
                    }
                  },
                  "required": [
                    "status",
                    "decision",
                    "modelVersion"
                  ],
                  "description": "FLAG requires PHISHING; PASS requires NORMAL; ABSTAIN permits null label. errorCode must be absent or null. The backend independently preserves rule scores."
                }
              }
            }
          },
          "401": {
            "description": "Invalid service credential"
          },
          "503": {
            "description": "Model unavailable"
          }
        }
      }
    },
    "/internal/v1/rag/answers": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "question": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  }
                },
                "required": [
                  "question"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Unwrapped AI result (not CommonResponse)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ANSWERED",
                        "INSUFFICIENT_EVIDENCE"
                      ]
                    },
                    "answer": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 10000,
                      "nullable": true
                    },
                    "chunkIds": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "format": "int64",
                        "minimum": 1
                      },
                      "minItems": 0,
                      "maxItems": 10
                    },
                    "modelVersion": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "nullable": true
                    },
                    "promptVersion": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "nullable": true
                    },
                    "reasonCode": {
                      "type": "string",
                      "nullable": true,
                      "maxLength": 100
                    },
                    "clarificationQuestion": {
                      "type": "string",
                      "nullable": true,
                      "maxLength": 500
                    },
                    "policyVersion": {
                      "type": "string",
                      "nullable": true,
                      "maxLength": 100
                    },
                    "evidenceSnapshots": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "contentHash",
                          "metadata"
                        ],
                        "properties": {
                          "contentHash": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "metadata": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "description": "ANSWERED requires nonempty answer/chunkIds, modelVersion, promptVersion, policyVersion=evidence-policy-v1 and an evidenceSnapshot per cited chunk. Spring compares content hash and metadata with the database. INSUFFICIENT_EVIDENCE has no answer/citations; reasonCode distinguishes conflict, missing evidence and clarification. Dates/priority/claims apply only within the reviewed corpus; semantic answer entailment is not guaranteed."
                }
              }
            }
          },
          "401": {
            "description": "Invalid service credential"
          },
          "503": {
            "description": "Model unavailable"
          }
        }
      }
    }
  }
}
